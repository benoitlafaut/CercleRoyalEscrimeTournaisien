@model CercleRoyalEscrimeTournaisien.Models.PoulesViewModel

@{
    string guid = Model.GuidTireurSelected;
    var tireur = !string.IsNullOrEmpty(guid)
        ? Model.TableTireursPourconstruireLesPoules.FirstOrDefault(x => x.GuidTireur == guid)
        : Model.TableTireursPourconstruireLesPoules.FirstOrDefault();

    if (tireur == null)
    {
        <div>Aucun tireur trouvé.</div>
        return;
    }
}

<h2>Modification du tireur : @tireur.Prenom @tireur.Nom</h2>

<!-- Sélecteur de tireur -->
<div style="margin-bottom:20px;">
    <label>Choisir un tireur :</label>
    <select class="form-control" onchange="changeTireur(this.value)">
        @foreach (var t in Model.TableTireursPourconstruireLesPoules.OrderBy(x => x.Prenom))
        {
            <option value="@t.GuidTireur" selected="@(t.GuidTireur == tireur.GuidTireur)">
                @t.Prenom @t.Nom
            </option>
        }
    </select>
</div>

<form id="formTireur" method="post" asp-action="ModifierLesDatasDUnTireur">

    <input type="hidden" name="GuidTireur" value="@tireur.GuidTireur" />

    <div class="row">
        <div class="col-md-6">

            <h4>Informations générales</h4>

            <div class="form-group">
                <label class="ClassAttributs">Période</label>
                <input class="form-control" name="Periode" value="@tireur.Periode" />
            </div>

            <div class="form-group">
                <label class="ClassAttributs">Prénom</label>
                <input class="form-control" name="Prenom" value="@tireur.Prenom" />
            </div>

            <div class="form-group">
                <label class="ClassAttributs">Nom</label>
                <input class="form-control" name="Nom" value="@tireur.Nom" />
            </div>

            <div class="form-group">
                <label class="ClassAttributs">Date de naissance</label>
                <input class="form-control" name="Birthdate" value="@tireur.Birthdate" />
            </div>

            <h4>Présences</h4>

            <div><label>Poule 1 => Poule des débutants</label></div>
            <div><label>Poule 2 => Poule Deuxième Troisième année</label></div>     
            <div><label>Poule 3 => Poule plus forte que les 3èmes années</label></div>
            <div><label>Poule 4 => Poule des adultes</label></div>
            <div style="margin-bottom:15px;"><label>Poule 5 => Poules des parents</label></div>

    <div class="form-group">
        <label class="ClassAttributs">Mercredi</label>
        <input class="form-control" name="DayMercredi" value="@tireur.DayMercredi" />
    </div>

    <div class="form-group">
        <label class="ClassAttributs">Vendredi</label>
        <input class="form-control" name="DayVendredi" value="@tireur.DayVendredi" />
    </div>

    <div class="form-group">
        <label class="ClassAttributs">Dimanche</label>
        <input class="form-control" name="DayDimanche" value="@tireur.DayDimanche" />
    </div>

    </div>

    <div class="col-md-6">

        <h4>Contacts</h4>

        <div class="form-group">
            <label class="ClassAttributs">Email propre</label>
            <input class="form-control" name="EmailPropre" value="@tireur.EmailPropre" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Email père</label>
            <input class="form-control" name="EmailPere" value="@tireur.EmailPere" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Email mère</label>
            <input class="form-control" name="EmailMere" value="@tireur.EmailMere" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Nom père</label>
            <input class="form-control" name="NomPere" value="@tireur.NomPere" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Nom mère</label>
            <input class="form-control" name="NomMere" value="@tireur.NomMere" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Fiche Signaletique Url</label>
            <input style="width:450px;" class="form-control" name="FicheSignaletiqueUrl" value="@tireur.FicheSignaletiqueUrl" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Seances Gratuites</label>
            <input class="form-control" name="SeancesGratuites" value="@tireur.SeancesGratuites" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Paiements Effectues</label>
            <input class="form-control" name="PaiementsEffectues" value="@tireur.PaiementsEffectues" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Téléphone propre</label>
            <input class="form-control" name="TelephonePropre" value="@tireur.TelephonePropre" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Téléphone père</label>
            <input class="form-control" name="TelephonePere" value="@tireur.TelephonePere" />
        </div>

        <div class="form-group">
            <label class="ClassAttributs">Téléphone mère</label>
            <input class="form-control" name="TelephoneMere" value="@tireur.TelephoneMere" />
        </div>

        <h4>État administratif</h4>

        @foreach (var prop in typeof(CercleRoyalEscrimeTournaisien.TableListeTireursData)
            .GetProperties()
            .Where(p => p.PropertyType == typeof(bool)))
        {
            var value = (bool)prop.GetValue(tireur);
            <div class="form-check">

                <input type="checkbox"
                       class="form-check-input"
                       name="@prop.Name"
                       value="true"
                       @(value ? "checked" : "") />
                <label class="form-check-label">@prop.Name</label>
            </div>
        }

    </div>
    </div>

    <button onclick="SaveData();" type="button" class="btn btn-primary" style="margin-top:20px;">Enregistrer</button>

</form>

<script>
    function changeTireur(guid) {
        window.location.href = '?guid=' + guid;
    }

    function SaveData() {
        $.ajax({
            url: '/Poules/ModifierLesDatasDUnTireur',
            type: 'POST',
            data: $('#formTireur').serialize(),
            success: function (response) {
                window.location.href = response.redirectUrl;
            }
        });
    }
</script>