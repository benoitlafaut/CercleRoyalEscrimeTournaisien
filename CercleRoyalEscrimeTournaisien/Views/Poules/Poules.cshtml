@model CercleRoyalEscrimeTournaisien.Models.PoulesViewModel
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

@Styles.Render("~/styles/Poules")
@Scripts.Render("~/bundles/PoulesJS")

@{
    string urlActionAjouterTireurAUnePoule = Url.Action("AjouterTireurAUnePoule", "Poules");
    string urlActionAjouterDesScores = Url.Action("AjouterDesScores", "Poules");
    string urlActionAfficherLesPoules = Url.Action("AfficherLesPoules", "Poules");
    string urlActionAfficherLesEliminationsDirectes = Url.Action("AfficherLesEliminationsDirectes", "Poules");
    string urlActionAfficherLesDatesPrecedentes = Url.Action("AfficherLesDatesPrecedentes", "Poules");
    string urlActionAjouterUnNewComer = Url.Action("AjouterUnNewComer", "Poules");
    string urlActionInitSession = Url.Action("InitSession", "Poules");
    string urlActionConstruireLesPoules = Url.Action("ConstruireLesPoules", "Poules");
    string urlActionModifierUnTireur = Url.Action("ModifierUnTireur", "Poules");
    string urlActionModifierLesDatasDUnTireur = Url.Action("ModifierLesDatasDUnTireur", "Poules");
    string urlActionConstruireLesLecons = Url.Action("ConstruireLesLecons", "Poules");
    string urlActionAfficherLesLecons = Url.Action("AfficherLesLecons", "Poules");

    string[] dateDuJourWithDayLabel = Model.DateDuJourWithDayLabel.Split(',');
    string classIndicatorAjoutTireur = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AddTireurs ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorAjouterScoreAUnePoule = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AjouterScoreAUnePoule ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorAfficherLesPoules = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AfficherLesPoules ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorAjoutUnNewComer = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AjouterUnNewComer ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorAfficherLesEliminationsDirectes = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AfficherLesEliminationsDirectes ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorAfficherLesDatesPrecedentes = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AfficherLesDatesPrecedentes ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorConstruireLesPoules = Model.ScreenIndex == ClassEnumScreen.EnumScreen.ConstruireLesPoules ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorModifierUnTireur = Model.ScreenIndex == ClassEnumScreen.EnumScreen.ModifierUnTireur ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorModifierLesDatasDUnTireur = Model.ScreenIndex == ClassEnumScreen.EnumScreen.ModifierLesDatasDUnTireur ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorConstruireLesLecons = Model.ScreenIndex == ClassEnumScreen.EnumScreen.ConstruireLesLecons ? "ClassIndicatorBorderAndColorBlue" : "";
    string classIndicatorAfficherLesLecons = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AfficherLesLecons ? "ClassIndicatorBorderAndColorBlue" : "";
}

<!DOCTYPE html>
<html>
<body id="bodyPoules">
    <div id="spinner-loading" class="loader-overlay">
        <div class="loader"></div>
    </div>

    <div class="ClassDivInFirstScreen">
        <button class="ClassTwoLignes ClassButtonEnteteTransparent">
            <span>@dateDuJourWithDayLabel[0]</span>
            <span>@dateDuJourWithDayLabel[1]</span>            
        </button>

        <button class="ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionInitSession'">
            <span>Init</span>
            <span>Session</span>
        </button>

        <button id="buttonAjoutUnNewComer" class="@classIndicatorAjoutUnNewComer ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAjouterUnNewComer'">
            <span>Ajouter un</span>
            <span>new comer</span>
        </button>

        <button id="buttonModifierUnTireur"  class="@classIndicatorModifierUnTireur ClassTwoLignes ClassButtonEntete ClassCursor" onclick="    $.startLoading(); location.href ='@urlActionModifierUnTireur'">
            <span>Modifier</span>
            <span>un tireur</span>
        </button>

        <button id="buttonConstruireLesPoules" class="@classIndicatorConstruireLesPoules ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionConstruireLesPoules'">
            <span>Construire</span>
            <span>les poules</span>
        </button>

        <button id="buttonAjoutTireur" class="@classIndicatorAjoutTireur ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAjouterTireurAUnePoule'">
            <span>Ajouter un tireur</span>
            <span>à une poule</span>
        </button>

        <button id="buttonAjouterScoreAUnePoule" class="@classIndicatorAjouterScoreAUnePoule ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAjouterDesScores'">
            <span>Ajouter un score</span>
            <span>à une poule</span>
        </button>

        <button id="buttonAfficherLesPoules"  class="@classIndicatorAfficherLesPoules ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAfficherLesPoules'">
            <span>Afficher</span>
            <span>les poules</span>
        </button>

        <button id="buttonAfficherLesEliminationsDirectes"  class="@classIndicatorAfficherLesEliminationsDirectes ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAfficherLesEliminationsDirectes'">
            <span>Afficher les</span>
            <span>éliminations directes</span>
        </button>

        <button id="buttonAfficherLesDatesPrecedentes"  class="@classIndicatorAfficherLesDatesPrecedentes ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAfficherLesDatesPrecedentes'">
            <span>Afficher les résultats</span>
            <span>des séances précédentes</span>
        </button>

        <button id="buttonModifierLesDatasDUnTireur"  class="@classIndicatorModifierLesDatasDUnTireur ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading(); location.href ='@urlActionModifierLesDatasDUnTireur'">
            <span>Modifier les datas</span>
            <span>d'un tireur</span>
        </button>

        <button id="buttonConstruireLesLecons"  class="@classIndicatorConstruireLesLecons ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading(); location.href ='@urlActionConstruireLesLecons'">
            <span>Construire</span>
            <span>les leçons</span>
        </button>

        <button id="buttonAfficherLesLecons"  class="@classIndicatorAfficherLesLecons ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading(); location.href ='@urlActionAfficherLesLecons'">
            <span>Afficher</span>
            <span>les leçons</span>
        </button>


    </div>


    @switch (Model.ScreenIndex)
    {

        case ClassEnumScreen.EnumScreen.AddTireurs:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AddTireurs, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AjouterUnNewComer:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AjouterUnNewComer, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AfficherLesPoules:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AfficherLesPoules, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AjouterScoreAUnePoule:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AjouterScoreAUnePoule, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AfficherLesEliminationsDirectes:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.PoulesEliminationsDirectes, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AfficherLesDatesPrecedentes:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AfficherLesDatesPrecedentes, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.ConstruireLesPoules:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.ConstruireLesPoules, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.ModifierUnTireur:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.ModifierUnTireur, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.ModifierLesDatasDUnTireur:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.ModifierLesDatasDUnTireur, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.ConstruireLesLecons:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.ConstruireLesLecons, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AfficherLesLecons:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AfficherLesLecons, Model)
            </div>

            break;
    }
</body>
</html>

<script>
$(document).ready(function () {

    const isMyOppo = getIsMyOppo();
 
    if (isMyOppo != true) {
        $("#buttonAjoutUnNewComer").css('display', 'none');
        $("#buttonModifierUnTireur").css('display', 'none');
        $("#buttonConstruireLesPoules").css('display', 'none');
        $("#buttonModifierLesDatasDUnTireur").css('display', 'none');
        $("#buttonConstruireLesLecons").css('display', 'none');
    }
});
</script>