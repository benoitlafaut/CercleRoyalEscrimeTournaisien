@model CercleRoyalEscrimeTournaisien.Models.PoulesViewModel

<div style="margin-bottom:15px;"></div>
@{ 
    var urlAfficherLesLecons = Url.Action("AfficherLesLecons", "Poules");
}

@Html.DropDownListFor(model => model.ArmeSelected, new SelectList(Model.ListArmes, "Key", "Value", Model.TireurSelected), new { @style="margin-bottom:15px;", @class = "form-control", @onchange = "window.location.href='/Poules/AfficherLesLecons?armeSelected=' + $(this).val();" })

@{
    foreach (var lecon in Model.ListDesLecons.OrderBy(x=>x.NombreDeLeconsDejaRecues).ThenBy(x => x.Age).ThenBy(x => x.Age))
    {
        <div class="ClassHeightInputLecon">
            <span style="min-width:380px;display:inline-block;">@lecon.Prénom @lecon.Nom (@lecon.Age ans) (@lecon.NombreDeLeconsDejaRecues leçons reçues)</span>
            <input style="height:30px;" type="button" value="Ajouter une leçon à ce tireur" 
                   onclick="AjouterUneLeconACeTireur( '@lecon.GuidTireur','@lecon.NombreDeLeconsDejaRecues');" />
            
        </div>
    }
}

<script>
    function AjouterUneLeconACeTireur(guidTireur, nombreDeLeconsDejaRecues) {
        var armeSelected = $("#ArmeSelected").val();       

        $.ajax({
            url: '/Poules/AjouterUneLeconACeTireur',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                ArmeSelected: armeSelected,
                GuidTireur: guidTireur,
                NombreDeLeconsDejaRecues: nombreDeLeconsDejaRecues
            }),
            success: function (result) {
                alert('leçon ajoutée');
                window.location.reload();
            }
        });
    }
</script>