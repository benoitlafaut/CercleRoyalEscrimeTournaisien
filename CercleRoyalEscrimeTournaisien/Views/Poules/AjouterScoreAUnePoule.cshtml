@model CercleRoyalEscrimeTournaisien.Models.PoulesViewModel
@{
    IEnumerable<SelectListItem> GetNumbersList = Model.PouleSelected == "Poule U11" ?
    new SelectList(new List<string> { "", "0", "1", "2", "3", "4" }) : new SelectList(new List<string> { "", "0", "1", "2", "3", "4", "5" });

    if (Model.PouleSelected == "Poule Senior")
    {
        var nombreDeTouchesMax = Model.PoulesList.FirstOrDefault(x => x.Poule == Model.PouleSelected).NombreDeTouchesMax;

        GetNumbersList = new SelectList( Enumerable.Range(0, nombreDeTouchesMax + 1).Select(i => i.ToString()).Prepend(""));
    }
}


<div style="margin-bottom:15px;margin-top:10px;">
    <select onchange="$.startLoading();location.href='@Url.Action("ChangePoulePourAjouterScore", "Poules")?pouleSelected=' + this.value" id="ddlPoulesScores" class="form-control">
        <option value=""> Sélectionnez la poule...</option>
        @foreach (var p in Model.PoulesList)
        {
            if (p.Poule == Model.PouleSelected)
            {
                <option selected value="@p.Poule"> @p.Poule (@p.DescriptionDeLaPoule) </option>
            }
            else
            {
                <option value="@p.Poule"> @p.Poule (@p.DescriptionDeLaPoule) </option>
            }
        }
    </select>
</div>

<div style=" margin-bottom: 15px; margin-top: 15px; ">

    <!-- Tireur 1 -->
    <div style="display: flex; align-items: center; margin-right: 20px; margin-bottom: 7px; margin-top: 7px;">
        <label style="margin-right:10px;">Tireur 1</label>
        @Html.DropDownListFor(
            model => model.Tireur1Selected,
            new SelectList(Model.ListTireursToAddScore, "Key", "Value", Model.Tireur1Selected),
            new { @class = "form-control", @style = "width:166px;" }
        )
    </div>

    <!-- Tireur 2 -->
    <div style="display: flex; align-items: center; margin-bottom: 7px; margin-top: 7px;">
        <label style="margin-right:10px;">Tireur 2</label>
        @Html.DropDownListFor(
            model => model.Tireur2Selected,
            new SelectList(Model.ListTireursToAddScore, "Key", "Value", Model.Tireur2Selected),
            new { @class = "form-control", @style = "width:166px;" }
        )
    </div>

</div>

@if (Model.PouleSelected == "Poule Senior")
{
    <div style="margin-bottom:15px;">
        <hr style=" margin-inline-start: 0px; margin-inline-end: 85%; " />
        <div>
            <label>Pour le moment, vous tirez en @Model.PoulesList.FirstOrDefault(x => x.Poule == Model.PouleSelected).NombreDeTouchesMax touches </label>
        </div>
        <div>
            <label>Voulez-vous le changer ? </label>
            <label><input type="radio" name="choixNombreDeTouchesMax" value="1" onclick="$('#divNombreNouveauDeTouches').css('display','block')">Oui</label>
            <label><input type="radio" name="choixNombreDeTouchesMax" checked value="2" onclick="$('#divNombreNouveauDeTouches').css('display','none')">Non</label>
        </div>
        <div style="display:none;" id="divNombreNouveauDeTouches">
            <span>Nombre de touches :</span>
            <input style="width:24px;" type="text" id="nombreDeTouchesChangees" />
            <input value="Save" style="min-width:50px;" onclick="EnregistrerNombreDeTouches('@Model.PouleSelected'); "  type="button" />
        </div>
        <hr style=" margin-inline-start: 0px; margin-inline-end: 85%; " />
    </div>
}

<div style="display: flex; margin-bottom: 15px;">
    <div>
        <label style="margin-right:10px;">Victoire :</label>
    </div>
    <div style="margin-right:15px;">
        <input type="radio" name="choixVictoire" value="1">Tireur 1
    </div>
    <div>
        <input type="radio" name="choixVictoire" value="2">Tireur 2
    </div>
</div>

<div style="display: flex; margin-bottom: 15px;">
    <div style="margin-right:25px;">
        <label style="margin-right:10px;">Score :</label>
    </div>
    <div style="margin-right:15px;">
        <label style="margin-right:10px;">Tireur 1</label>
        @Html.DropDownList("ScoreTireur1", GetNumbersList, new { @class = "dropdown", @style = "width:40px;" })
    </div>
    <div>
        <label style="margin-right:10px;">Tireur 2</label>
        @Html.DropDownList("ScoreTireur2", GetNumbersList, new { @class = "dropdown", @style = "width:40px;" })
    </div>
</div>

<div style="display: flex; margin-bottom: 5px;">
    <div style="margin-right:25px;">
        <label style="margin-right:10px;">Le tireur qui a perdu a-t-il mené ?</label>
    </div>
</div>
<div style="display: flex; margin-bottom: 15px;">
    <div style="margin-right:15px;">
        <input type="radio" name="choixMene" value="1">Oui
    </div>
    <div style="margin-right:15px;">
        <input type="radio" name="choixMene" value="2">Non
    </div>
    <div>
        <input type="radio" name="choixMene" value="3">Je ne sais pas
    </div>
</div>

<div class="ClassMarginTopAndBottom">
    <a href="#" onclick="AddScoreToTireursSelected(); " class="btnAction-custom">&nbsp;&nbsp;Ajouter 1 score aux tireurs sélectionnés&nbsp;&nbsp;</a>
</div>

<script>
    document.querySelectorAll('.choixVictoire').forEach(td => {
        td.addEventListener('click', function () { this.querySelector('input[type=radio]').checked = true; });
    });
</script>