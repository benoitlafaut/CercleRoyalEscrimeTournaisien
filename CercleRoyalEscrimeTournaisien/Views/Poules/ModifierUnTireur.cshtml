@model CercleRoyalEscrimeTournaisien.Models.PoulesViewModel

<div style="margin-top: 10px;">
    @Html.DropDownListFor(model => model.TireurSelected, new SelectList(Model.ListTireurs, "Key", "Value", Model.TireurSelected), new { @class = "form-control", @onchange = "SearchDataTireur(this.value);" })
</div>

<div class="ClassMarginTopAndBottom10">
    <span style="min-width: 120px; display: inline-block;">Date de naissance:</span>
    @Html.TextBoxFor(x => x.NewComerBirthDate, new { @class = "", style = "width: 150px;" })
</div>

<div class="ClassMarginTopAndBottom10">
    <span style="min-width: 120px; display: inline-block;">Mercredi:</span>
    @Html.DropDownListFor(model => model.NewComerDayMercrediSelected, new SelectList(Model.NewComerDayList, "Key", "Value", Model.NewComerDayMercrediSelected), new { @class = "form-control", @onchange = "" })
</div>

<div class="ClassMarginTopAndBottom10">
    <span style="min-width: 120px; display: inline-block;">Vendredi:</span>
    @Html.DropDownListFor(model => model.NewComerDayVendrediSelected, new SelectList(Model.NewComerDayList, "Key", "Value", Model.NewComerDayVendrediSelected), new { @class = "form-control", @onchange = "" })
</div>

<div class="ClassMarginTopAndBottom10">
    <span style="min-width: 120px; display: inline-block;">Dimanche:</span>
    @Html.DropDownListFor(model => model.NewComerDayDimancheSelected, new SelectList(Model.NewComerDayList, "Key", "Value", Model.NewComerDayDimancheSelected), new { @class = "form-control", @onchange = "" })
</div>

<div class="ClassMarginTopAndBottom">
    <a href="#" onclick="ModifierUnTireur(); " class="btnAction-custom">Modifier un tireur</a>
</div>

@functions {
    public int GetAge(string birthdateString)
    {
        var birthdate = DateTime.ParseExact(
           birthdateString,
           "dd/MM/yyyy",
           System.Globalization.CultureInfo.InvariantCulture
       );

        var today = DateTime.Today;
        var age = today.Year - birthdate.Year;

        if (birthdate.Date > today.AddYears(-age))
            age--;

        return age;
    }

    public int GetYear(string birthdateString)
    {
        var birthdate = DateTime.ParseExact(
           birthdateString,
           "dd/MM/yyyy",
           System.Globalization.CultureInfo.InvariantCulture
       );       

        return birthdate.Year;
    }
}

@foreach (var item in Model.NewComerDayList)
{
    if (item.Key != "" && item.Key != "Poule U11-U13" && item.Key != "Poule U13-U15")
    {
        <div style="margin-top:15px;margin-bottom:15px;">
            <span>
                @item
            </span>
        </div>

        <div style="margin-left:15px;">
            <span>Mercredi : </span>
            <div style="margin-left: 10px; width: 90%;">
                @foreach (var tireur in Model.TableTireursPourconstruireLesPoules.Where(x => x.DayMercredi == item.Key))
                {
                    var age = GetAge(tireur.Birthdate);
                    var year = GetYear(tireur.Birthdate);

                    <span>@tireur.Prenom (@age @year)&nbsp;&nbsp;</span>
                }
            </div>
        </div>
        <div style="margin-left:15px;">
            <span>Vendredi : </span>
            <div style="margin-left: 10px; width: 90%;">
                @foreach (var tireur in Model.TableTireursPourconstruireLesPoules.Where(x => x.DayVendredi == item.Key))
                {
                    var age = GetAge(tireur.Birthdate);
                    var year = GetYear(tireur.Birthdate);

                    <span>@tireur.Prenom (@age @year)&nbsp;&nbsp;</span>
                }
            </div>
        </div>
        <div style="margin-left:15px;">
            <span>Dimanche : </span>
            <div style="margin-left:10px;width:90%;">
                @foreach (var tireur in Model.TableTireursPourconstruireLesPoules.Where(x => x.DayDimanche == item.Key))
                {
                    var age = GetAge(tireur.Birthdate);
                    var year = GetYear(tireur.Birthdate);

                    <span>@tireur.Prenom (@age @year)&nbsp;&nbsp;</span>
                }
            </div>
        </div>
    }
}