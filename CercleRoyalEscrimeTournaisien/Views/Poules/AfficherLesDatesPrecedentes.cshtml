@model CercleRoyalEscrimeTournaisien.Models.PoulesViewModel

<div style="margin-top:10px;">
    <span>Liste des Dates d'entraînement: </span>

    <select onchange="$.startLoading();location.href='@Url.Action("ChangeDateDeLaPoule", "Poules")?dateDeLaPouleSelected=' + this.value" class="form-control">
        <option value="">Sélectionnez la date antérieure à aujourd'hui...</option>
        @foreach (var p in Model.DatesPourToutesLesPoulesList.OrderByDescending(x => x.DateDeLaPoule.Substring(6, 4) + "-" + x.DateDeLaPoule.Substring(3, 2) + "-" + x.DateDeLaPoule.Substring(0, 2)).ToList())
        {
            if (string.IsNullOrEmpty(p.Arme))
            {
                <option value="@p.DateDeLaPoule">@p.DateDeLaPoule</option>
            }
            else
            {
                <option value="@p.DateDeLaPoule">@p.DateDeLaPoule (@p.Arme)</option>
            }
        }
    </select>
</div>

<div class="ClassMarginTopAndBottom">
    <a onclick="$.startLoading();" href="@Url.Action("ResetDates", "Poules")" class="btnAction-custom">Revenir à la date du jour</a>
</div>


<hr/>

<div style="margin-top: 10px;">
    @Html.DropDownListFor(
    model => model.TireurSelected,
    new SelectList(Model.ListTireurs, "Key", "Value", Model.TireurSelected),
    "-- Sélectionner un tireur --",
    new
    {
        @class = "form-control",
        @onchange = "SearchDatesPresenceTireur(this.value);"
    })

    @*@Html.DropDownListFor(model => model.TireurSelected, new SelectList(Model.ListTireurs, "Key", "Value", Model.TireurSelected), new { @class = "form-control", @onchange = "SearchDatesPresenceTireur(this.value);" })*@
</div>

<div id="PartialViewDatePresenceList" style="margin-top:15px;">
    @Html.Partial("PartialViewDatePresenceList", new List<string>())
</div>