@model CercleRoyalEscrimeTournaisien.Models.PoulesViewModel
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

@Styles.Render("~/styles/Poules")
@Scripts.Render("~/bundles/PoulesJS")

@{
    string urlActionAjouterTireurAUnePoule = Url.Action("AjouterTireurAUnePoule", "NewPoules");
    string urlActionAjouterDesScores = Url.Action("AjouterDesScores", "NewPoules");
    string urlActionAfficherLesPoules = Url.Action("AfficherLesPoules", "NewPoules");
    string urlActionAfficherLesEliminationsDirectes = Url.Action("AfficherLesEliminationsDirectes", "NewPoules");
    string urlActionAfficherLesDatesPrecedentes = Url.Action("AfficherLesDatesPrecedentes", "NewPoules");

    string[] dateDuJourWithDayLabel = Model.DateDuJourWithDayLabel.Split(',');
    string classIndicatorAjoutTireur = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AddTireurs ? "ClassIndicatorAjoutTireur" : "";
    string classIndicatorAjouterScoreAUnePoule = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AjouterScoreAUnePoule ? "ClassIndicatorAjouterScoreAUnePoule" : "";
    string classIndicatorAfficherLesPoules = Model.ScreenIndex == ClassEnumScreen.EnumScreen.AfficherLesPoules ? "ClassIndicatorAfficherLesPoules" : "";
}

<!DOCTYPE html>
<html>
<body id="">
    <div id="spinner-loading" class="loader-overlay">
        <div class="loader"></div>
    </div>

    <div style="display:flex;">
        <button class="ClassTwoLignes ClassButtonEnteteTransparent">
            <span>@dateDuJourWithDayLabel[0]</span>
            <span>@dateDuJourWithDayLabel[1]</span>
        </button>

        <button class="@classIndicatorAjoutTireur ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAjouterTireurAUnePoule'">
            <span>Ajouter un tireur</span>
            <span>à une poule</span>
        </button>

        <button class="@classIndicatorAjouterScoreAUnePoule ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAjouterDesScores'">
            <span>Ajouter un score</span>
            <span>à une poule</span>
        </button>

        <button class="@classIndicatorAfficherLesPoules ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAfficherLesPoules'">
            <span>Afficher</span>
            <span>les poules</span>
        </button>

        <button class="ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAfficherLesEliminationsDirectes'">
            <span>Afficher les</span>
            <span>éliminations directes</span>
        </button>

        <button class="ClassTwoLignes ClassButtonEntete ClassCursor" onclick="$.startLoading();location.href='@urlActionAfficherLesDatesPrecedentes'">
            <span>Afficher les résultats</span>
            <span>des séances précédentes</span>
        </button>
    </div>


    @switch (Model.ScreenIndex)
    {

        case ClassEnumScreen.EnumScreen.AddTireurs:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AddTireurs, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AfficherLesPoules:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AfficherLesPoules, Model)
            </div>

            break;
        case ClassEnumScreen.EnumScreen.AjouterScoreAUnePoule:
            <div class="infos1 clearfix">
                @Html.Partial(PartialViewNames.AjouterScoreAUnePoule, Model)
            </div>

            break;
            @*case ClassEnumScreen.EnumScreen.AfficherLesEliminationsDirectes:
                    <div class="infos1 clearfix">
                        @Html.Partial(PartialViewNames.PoulesEliminationsDirectes, Model)
                    </div>

                    break;
                case ClassEnumScreen.EnumScreen.AfficherLesDatesPrecedentes:
                    <div class="infos1 clearfix">
                        @Html.Partial(PartialViewNames.AfficherLesDatesPrecedentes, Model)
                    </div>

                    break;*@
    }
</body>
</html>